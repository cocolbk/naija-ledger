# Copy to server/.env and fill in. NEVER commit .env.
PORT=3000
DATABASE_URL=postgres://naija_app:CHANGE_ME@localhost:5433/naija_ledger

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=CHANGE_ME_32_BYTES_MIN
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (dashboard: R2 -> Manage R2 API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=naija-ledger-receipts
